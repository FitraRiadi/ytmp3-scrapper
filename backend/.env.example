# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env tidak ikut di-commit (lihat .gitignore).

DJANGO_DEBUG=1
# Ganti dengan string acak untuk pemakaian di luar lokal.
DJANGO_SECRET_KEY=dev-only-change-me

# PostgreSQL
DB_NAME=ytmp3_scrapper
DB_USER=postgres
DB_PASSWORD=isi-password-postgres-kamu
DB_HOST=127.0.0.1
DB_PORT=5432

# Opsional: folder simpan default.
# Bisa juga diganti kapan saja dari menu pengaturan di aplikasi.
# DOWNLOAD_DIR=D:\Music\ytmp3
